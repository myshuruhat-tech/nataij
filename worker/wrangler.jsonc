{
  // الاسم لازم يطابق اسم الـ Worker في Cloudflare
  "name": "nataij-api",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // تخزين قوائم الحجب (يُنشأ تلقائياً عند النشر؛ لو اشتكى، أنشئ KV يدوياً وحط "id" هنا)
  "kv_namespaces": [{ "binding": "LISTS" }]
  // مهم: لازم Secret اسمه ADMIN_KEY (من لوحة Cloudflare) عشان تطبيق الأم يقدر يحدّث القوائم
}
